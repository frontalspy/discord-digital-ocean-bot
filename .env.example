# Discord
DISCORD_TOKEN=your_discord_bot_token_here
# Optional: restrict slash commands to one guild for instant registration
DISCORD_GUILD_ID=your_guild_id_here

# Digital Ocean
DO_API_TOKEN=your_digitalocean_api_token_here
# Name used for both the droplet and the snapshot (default: pew-pew)
DO_DROPLET_NAME=pew-pew
# The reserved IP address string (e.g. 123.45.67.89)
DO_RESERVED_IP=your_reserved_ip_here
# Droplet lifetime in hours before auto-shutdown (default: 6)
DROPLET_LIFETIME_HOURS=6
# Name of an SSH key already added to your DigitalOcean account (Settings >
# Security > SSH Keys). Attached to new droplets so DO doesn't fall back to
# emailing a random root password. Leave unset to skip.
DO_SSH_KEY_NAME=your_ssh_key_name_here

# SSH — used to run commands on the droplet after boot
SSH_PRIVATE_KEY_PATH=/path/to/your/private/key
SSH_USERNAME=root
# SSH_PASSPHRASE=optional_passphrase_if_key_is_encrypted
# Commands to run on the droplet after boot, separated by |
SSH_STARTUP_COMMANDS=command_one | command_two
